    "蛋白" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Protein"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"蛋白質"}}}},
    "包装每份约" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"About"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"包裝每份約"}}}},
    "包装每份" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Package serving"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"包裝每份"}}}},
    "每包约" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"About"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"每包約"}}}},
    "标准配方原有" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Standard recipe"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"標準配方原有"}}}},
    "最终总量" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Final total"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"最終總量"}}}},
    "泵" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"pumps"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"泵"}}}},
    "估算区间" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Estimated range"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"估算區間"}}}},
    "合理区间" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reasonable range"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"合理區間"}}}},
    "估算" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Estimated"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"估算"}}}},
    "宏量数据覆盖" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Macro data coverage"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"宏量資料覆蓋"}}}},
    "按已记录热量" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"by logged calories"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"依已記錄熱量"}}}},
    "暂无数据" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No data"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"暫無資料"}}}},
    "保存常用商品失败" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Couldn’t Save Favorite Product"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"儲存常用商品失敗"}}}},
    "保存商品失败" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Couldn’t Save Product"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"儲存商品失敗"}}}},
    "设置" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Settings"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"設定"}}}},
    "个人资料" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Profile"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"個人資料"}}}},
    "性别" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Sex"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"性別"}}}},
    "从 Apple 健康同步身高/年龄/性别" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Sync Height, Age & Sex from Apple Health"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"從 Apple 健康同步身高／年齡／性別"}}}},
    "Apple 健康有数据时优先使用健康数据；这里的值仅作兜底。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Apple Health data takes priority when available. These values are only fallbacks."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Apple 健康有資料時會優先使用；這裡的值僅作備援。"}}}},
    "身体成分" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Body Composition"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"身體組成"}}}},
    "严格区分完整去脂体重、DEXA 瘦软组织、四肢瘦体重、Fitdays 肌肉量、骨骼肌和 SMI。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Keeps total fat-free mass, DEXA lean soft tissue, appendicular lean mass, Fitdays muscle mass, skeletal muscle, and SMI distinct."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"嚴格區分完整去脂體重、DEXA 瘦軟組織、四肢瘦體重、Fitdays 肌肉量、骨骼肌和 SMI。"}}}},
    "起始体重" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Starting Weight"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"起始體重"}}}},
    "开始日期" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Start Date"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"開始日期"}}}},
    "计入 Apple 健康活动能量" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Include Apple Health Active Energy"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"計入 Apple 健康活動能量"}}}},
    "基础活动水平" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Baseline Activity Level"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"基礎活動水平"}}}},
    "久坐（几乎不运动）" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Sedentary (little exercise)"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"久坐（幾乎不運動）"}}}},
    "轻度活动（每周运动 1-3 次）" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Lightly Active (1–3 times/week)"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"輕度活動（每週運動 1–3 次）"}}}},
    "中度活动（每周运动 3-5 次）" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Moderately Active (3–5 times/week)"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"中度活動（每週運動 3–5 次）"}}}},
    "消耗计算" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Expenditure Calculation"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"消耗計算"}}}},
    "当前模式：总消耗 = 基础代谢 × 1.1（食物热效应）+ 手表实测的全天活动能量。活动系数不参与计算，避免把日常活动算两遍。当天预算会随活动量实时增长。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Current mode: total expenditure = BMR × 1.1 (thermic effect of food) + all-day active energy measured by your watch. The activity factor is excluded to avoid double counting daily activity. Today’s budget grows with activity."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"目前模式：總消耗 = 基礎代謝 × 1.1（食物熱效應）+ 手錶實測的全天活動能量。活動係數不參與計算，避免把日常活動算兩次。當天預算會隨活動量即時增加。"}}}},
    "当前模式：总消耗 = 基础代谢 × 活动系数（粗略估算）。有 Apple Watch 时建议打开上方开关，用实测值更准。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Current mode: total expenditure = BMR × activity factor (rough estimate). If you use Apple Watch, enable the switch above for measured activity."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"目前模式：總消耗 = 基礎代謝 × 活動係數（粗略估算）。有 Apple Watch 時建議開啟上方開關，使用實測值更準。"}}}},
    "营养目标" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Nutrition Goals"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"營養目標"}}}},
    "训练日会在同样的热量预算内适当提高碳水、降低脂肪；蛋白质和每日总热量不变。这只是燃料安排，不代表减脂会更快。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Training days shift some calories from fat to carbs while keeping protein and total calories unchanged. This is fuel timing, not faster fat loss."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"訓練日會在相同熱量預算內適度提高碳水、降低脂肪；蛋白質與每日總熱量不變。這只是燃料安排，不代表減脂會更快。"}}}},
    "默认使用稳定的保肌营养目标。需要时可开启训练日燃料调整；不会自动猜测训练日。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Uses stable muscle-retention nutrition goals by default. Enable training-day fuel adjustments when needed; the app won’t guess training days."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"預設使用穩定的保肌營養目標。需要時可開啟訓練日燃料調整；不會自動猜測訓練日。"}}}},
    "20:30 饮食记录提醒" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"8:30 PM Food Log Reminder"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"20:30 飲食記錄提醒"}}}},
    "8:00 称重提醒" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"8:00 AM Weigh-In Reminder"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"8:00 量體重提醒"}}}},
    "每日提醒" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Daily Reminders"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"每日提醒"}}}},
    "只有当天还没有对应记录时才会提醒。首次开启会申请系统通知权限。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A reminder is sent only if the matching entry is still missing that day. Enabling it for the first time requests notification permission."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"只有當天還沒有對應記錄時才會提醒。首次開啟會申請系統通知權限。"}}}},
    "AI 拍照识别" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"AI Photo Recognition"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"AI 拍照辨識"}}}},
    "识别方式" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recognition Method"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"辨識方式"}}}},
    "Mac mini + ChatGPT 订阅" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Mac mini + ChatGPT Subscription"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Mac mini + ChatGPT 訂閱"}}}},
    "https://你的私有桥接地址" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"https://your-private-bridge-address"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"https://你的私人橋接位址"}}}},
    "请输入完整的 HTTPS 地址；地址不能包含用户名、密码、查询参数或片段。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter a complete HTTPS address. The address must not include a username, password, query parameters, or a fragment."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請輸入完整的 HTTPS 位址；位址不得包含使用者名稱、密碼、查詢參數或片段。"}}}},
    "私有 AI 识别桥接 HTTPS 地址" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Private AI Recognition Bridge HTTPS Address"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"私人 AI 辨識橋接 HTTPS 位址"}}}},
    "保存并检测" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Save & Test"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"儲存並檢測"}}}},
    "清除并禁用" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Clear & Disable"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"清除並停用"}}}},
    "尚未配置；照片不会上传，手动记录仍可使用" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Not configured. Photos won’t be uploaded; manual logging still works."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"尚未設定；照片不會上傳，手動記錄仍可使用"}}}},
    "正在检查 Mac mini…" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Checking Mac mini…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在檢查 Mac mini…"}}}},
    "识别服务在线" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recognition Service Online"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"辨識服務在線"}}}},
    "识别模型" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recognition Model"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"辨識模型"}}}},
    "Mac mini 暂时离线" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Mac mini Temporarily Offline"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Mac mini 暫時離線"}}}},
    "重新检测" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Test Again"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"重新檢測"}}}},
    "每位使用者必须填写自己的 HTTPS 私有桥接地址。这里仅保存 URL，绝不能填写 API Key、密码或访问令牌。未配置时照片不会上传；临时照片在请求后删除，结果和份量仍需确认。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Each user must enter their own private HTTPS bridge address. Only the URL is stored here—never enter an API key, password, or access token. Without configuration, photos aren’t uploaded. Temporary photos are deleted after each request, and results and portions still require confirmation."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"每位使用者都必須填寫自己的 HTTPS 私人橋接位址。這裡只儲存 URL，絕不能填入 API Key、密碼或存取權杖。未設定時照片不會上傳；暫存照片會在請求後刪除，結果與份量仍需確認。"}}}},
    "地址已保存在本机；正在检测连接。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Address saved on this device. Testing the connection."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"位址已儲存在本機；正在檢測連線。"}}}},
    "已清除并禁用 AI 桥接；照片不会上传。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"AI bridge cleared and disabled. Photos won’t be uploaded."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已清除並停用 AI 橋接；照片不會上傳。"}}}},
    "Apple 健康" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Apple Health"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Apple 健康"}}}},
    "可用" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Available"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"可用"}}}},
    "不可用" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unavailable"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"不可用"}}}},
    "最近体重" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Latest Weight"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"最近體重"}}}},
    "未读取到" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Not Read"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"未讀取到"}}}},
    "今日活动能量" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Active Energy Today"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"今日活動能量"}}}},
    "请求健康数据授权" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Request Health Data Access"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請求健康資料授權"}}}},
    "关于" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"About"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"關於"}}}},
    "本 App 的热量估算仅供参考，不构成医疗建议。如有健康问题请咨询医生或注册营养师。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Calorie estimates are for reference only and are not medical advice. Consult a doctor or registered dietitian for health concerns."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"本 App 的熱量估算僅供參考，不構成醫療建議。如有健康問題，請諮詢醫師或註冊營養師。"}}}},
    "通知权限未开启" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Notifications Are Off"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"通知權限未開啟"}}}},
    "前往系统设置" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open Settings"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"前往系統設定"}}}},
    "请在系统设置中允许「减重助手」发送通知后，再开启每日提醒。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allow WeightCoach notifications in Settings, then enable daily reminders."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請在系統設定中允許「減重助手」傳送通知後，再開啟每日提醒。"}}}},
    "今日" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Today"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"今日"}}}},
    "快捷记录失败" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Quick Log Failed"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"快速記錄失敗"}}}},
    "扫条形码" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Scan Barcode"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"掃描條碼"}}}},
    "本周能量账本" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Weekly Energy Ledger"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"本週能量帳本"}}}},
    "估算缺口" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Estimated Deficit"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"估算缺口"}}}},
    "估算盈余" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Estimated Surplus"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"估算盈餘"}}}},
    "趋势读取失败，点此重试" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Couldn’t Load Trends. Tap to Retry."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"趨勢讀取失敗，點此重試"}}}},
    "数据不足，暂不能计算" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Not Enough Data to Calculate"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"資料不足，暫時無法計算"}}}},
    "能量差" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Energy Balance"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"能量差"}}}},
    "正数为缺口，负数为盈余；只统计已记录且数据可用的日期。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Positive values are deficits and negative values are surpluses. Only days with recorded, usable data are included."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正數為缺口，負數為盈餘；只統計已記錄且資料可用的日期。"}}}},
    "打开近 7 天和近 30 天详细趋势" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open detailed 7-day and 30-day trends"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"開啟近 7 天與近 30 天詳細趨勢"}}}},
    "最近吃过 · 点一下直接记" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recently Eaten · Tap to Log"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"最近吃過 · 點一下直接記"}}}},
    "常吃与最近 · 点一下直接记" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Frequent & Recent · Tap to Log"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"常吃與最近 · 點一下直接記"}}}},
    "常吃" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Frequent"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"常吃"}}}},
    "最近" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recent"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"最近"}}}},
    "按上次份量" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use Last Portion"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"依上次份量"}}}},
    "按上次记录" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use Last Entry"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"依上次記錄"}}}},
    "🎉 已达成目标！继续保持" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"🎉 Goal Reached! Keep It Up"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"🎉 已達成目標！繼續保持"}}}},
    "连接 Apple 健康" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connect Apple Health"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"連接 Apple 健康"}}}},
    "尚未读取到体重数据。请确认已授权本 App 读取健康数据（设置 → 健康 → 数据访问与设备），或在「体重」页手动记录一次。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No weight data was found. Confirm that Health access is allowed (Settings → Health → Data Access & Devices), or log a weight manually on the Weight tab."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"尚未讀取到體重資料。請確認已允許本 App 讀取健康資料（設定 → 健康 → 資料存取與裝置），或在「體重」頁手動記錄一次。"}}}},
    "当前设备不支持 HealthKit，将使用手动记录的数据。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"HealthKit isn’t supported on this device. Manually logged data will be used."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"目前裝置不支援 HealthKit，將使用手動記錄的資料。"}}}},
    "重新请求授权" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Request Access Again"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"重新請求授權"}}}},
    "近 7 天" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Last 7 Days"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"近 7 天"}}}},
    "近 30 天" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Last 30 Days"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"近 30 天"}}}},
    "能量" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Energy"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"能量"}}}},
    "时间范围" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Time Range"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"時間範圍"}}}},
    "趋势指标" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Trend Metric"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"趨勢指標"}}}},
    "正在读取历史数据…" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Loading History…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在讀取歷史資料…"}}}},
    "趋势暂时不可用" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Trends Temporarily Unavailable"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"趨勢暫時無法使用"}}}},
    "饮食与能量趋势" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Food & Energy Trends"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"飲食與能量趨勢"}}}},
    "截至昨天" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Through Yesterday"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"截至昨天"}}}},
    "本周还没有已结束的日期" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No Completed Days This Week Yet"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"本週還沒有已結束的日期"}}}},
    "数据不足，暂不能计算本周能量差" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Not Enough Data to Calculate This Week’s Energy Balance"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"資料不足，暫時無法計算本週能量差"}}}},
    "正数为缺口，负数为盈余；周末多吃会抵消之前的缺口。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Positive values are deficits and negative values are surpluses. Weekend overeating offsets earlier deficits."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正數為缺口，負數為盈餘；週末多吃會抵消之前的缺口。"}}}},
    "每日摄入与估算消耗" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Daily Intake & Estimated Expenditure"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"每日攝取與估算消耗"}}}},
    "已记录摄入" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Logged Intake"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已記錄攝取"}}}},
    "估算消耗" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Estimated Expenditure"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"估算消耗"}}}},
    "平衡" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Balance"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"平衡"}}}},
    "缺口" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Deficit"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"缺口"}}}},
    "盈余" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Surplus"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"盈餘"}}}},
    "每日估算能量差" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Daily Estimated Energy Balance"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"每日估算能量差"}}}},
    "今天尚未结束，不进入能量差与本周累计。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Today is still in progress and is excluded from energy balance and weekly totals."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"今天尚未結束，不會納入能量差與本週累計。"}}}},
    "数据覆盖" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Data Coverage"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"資料覆蓋"}}}},
    "柱子越浅，代表当天宏量营养数据越不完整；未知值不会按 0 计算。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Lighter bars mean less complete macro data for that day. Unknown values are not treated as zero."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"柱子越淺，表示當天宏量營養資料越不完整；未知值不會以 0 計算。"}}}},
    "结果会随 Apple 健康延迟同步而更新，只代表已记录数据，不是精密代谢测量。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Results update as delayed Apple Health data syncs. They reflect logged data, not precise metabolic measurement."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"結果會隨 Apple 健康延遲同步而更新，只代表已記錄資料，不是精密代謝測量。"}}}},
    "营养数据完整度未知" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Nutrition data completeness unknown"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"營養資料完整度未知"}}}},
    "校准体脂" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Calibrated Body Fat"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"校準體脂"}}}},
    "趋势" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Trend"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"趨勢"}}}},
