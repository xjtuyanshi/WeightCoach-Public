        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "今天还没记录饮食" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "今天還沒記錄飲食" } }
      }
    },
    "notification.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "WeightCoach" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "减重助手" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "減重助手" } }
      }
    },
    "notification.weight.body" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Good morning — remember to weigh in" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "早上好，记得称重" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "早安，記得量體重" } }
      }
    },
    "food.health.delete.failed" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The matching Apple Health record could not be deleted. The local food entry was kept." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Apple 健康中的对应记录未能删除，本地饮食记录已保留。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Apple 健康中的對應記錄無法刪除，本機飲食記錄已保留。" } }
      }
    },
    "food.health.sync.cleanup.failed" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The previous Apple Health sample could not be cleaned up, so retry stopped to prevent duplicates." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "旧的 Apple 健康样本尚未清理；为避免重复记录，已停止重试。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "舊的 Apple 健康樣本尚未清除；為避免重複記錄，已停止重試。" } }
      }
    },
    "food.health.sync.entryDeleted" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The local food entry was already deleted, so nothing new was written to Apple Health." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "本地饮食记录已经删除，未继续写入 Apple 健康。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "本機飲食記錄已刪除，因此未繼續寫入 Apple 健康。" } }
      }
    },
    "food.health.sync.local.failed" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The Apple Health sync status could not be saved. Please try again." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Apple 健康同步状态未能保存，请稍后重试。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Apple 健康同步狀態無法儲存，請稍後再試。" } }
      }
    },
    "food.health.sync.unavailable" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The food entry was saved in the app, but Apple Health is currently unavailable." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "饮食已保存在 App，但当前无法写入 Apple 健康。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "飲食已儲存在 App，但目前無法寫入 Apple 健康。" } }
      }
    },
    "food.health.sync.write.failed" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The food entry remains saved in the app, but Apple Health sync failed." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "饮食仍保存在 App，但 Apple 健康同步失败。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "飲食仍保存在 App，但 Apple 健康同步失敗。" } }
      }
    },
    "food.local.delete.failed" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The local food entry could not be deleted. Please try again." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "本地饮食记录未能删除，请稍后重试。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "本機飲食記錄無法刪除，請稍後再試。" } }
      }
    },
    "food.local.delete.remoteDeleted" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The Apple Health record was deleted, but the local entry could not be removed. Please retry; cleanup is idempotent." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Apple 健康记录已删除，但本地记录暂时未能移除。请稍后重试；再次操作只会做幂等清理。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Apple 健康記錄已刪除，但本機記錄暫時無法移除。請稍後再試；再次操作只會進行冪等清理。" } }
      }
    },
    "最近刷新失败，当前周数据可能已过期；点开趋势页可重试。" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The latest refresh failed, so this week's data may be outdated. Open Trends to retry." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "最近刷新失败，当前周数据可能已过期；点开趋势页可重试。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "最近重新整理失敗，本週資料可能已過期；開啟趨勢頁即可重試。" } }
      }
    },
    "部分日期使用了有日期依据的校准体脂估算基础代谢。" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Some days estimate BMR using a calibrated body-fat value with a recorded date." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "部分日期使用了有日期依据的校准体脂估算基础代谢。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "部分日期使用有日期依據的校準體脂估算基礎代謝。" } }
      }
    },
    "部分日期缺少历史体重，已使用档案起始体重估算。" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Historical weight was missing for some days, so the profile start weight was used as an estimate." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "部分日期缺少历史体重，已使用档案起始体重估算。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "部分日期缺少歷史體重，因此使用檔案起始體重估算。" } }
      }
    },
    "照片会保留在本页供你核对；未明确识别为餐盘时不会随记录保存" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The photo stays on this screen for review and is not saved with the entry unless it is clearly identified as a food photo." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "照片会保留在本页供你核对；未明确识别为餐盘时不会随记录保存" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "照片會保留在本頁供你核對；未明確辨識為餐盤時不會隨記錄儲存" } }
      }
    },
