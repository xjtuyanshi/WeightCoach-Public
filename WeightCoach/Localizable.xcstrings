    "common_food.whole-wheat-bread.name" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Whole-Wheat Bread"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"全麦面包"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"全麥麵包"}}}},
    "common_food.whole-wheat-bread.preparation" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Commercial product, by edible weight"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"市售成品，按实际可食重量"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"市售成品，依實際可食重量"}}}},
    "common_food.whole-milk.name" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Whole Milk"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"全脂牛奶"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"全脂牛奶"}}}},
    "common_food.whole-milk.preparation" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"3.25% milkfat with added vitamin D; by actual weight"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"3.25% 乳脂、添加维生素 D，按实际重量"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"3.25% 乳脂、添加維生素 D，依實際重量"}}}},
    "common_food.cola-regular.name" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Regular Cola"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"普通可乐"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"一般可樂"}}}},
    "common_food.cola-regular.preparation" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Sugar-sweetened carbonated beverage, by actual weight; formulations vary by brand"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"含糖碳酸饮料，按实际重量；品牌配方可能不同"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"含糖碳酸飲料，依實際重量；品牌配方可能不同"}}}},
    "common_food.latte-hot-2-percent-unsweetened.name" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unsweetened Hot Latte (2% Milk)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无糖热拿铁（2% 牛奶）"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無糖熱拿鐵（2% 牛奶）"}}}},
    "common_food.latte-hot-2-percent-unsweetened.preparation" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"2 espresso shots with 10 fl oz 2% milk; no syrup"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"2 份浓缩咖啡加 10 液盎司 2% 牛奶，不含糖浆"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"2 份濃縮咖啡加 10 液量盎司 2% 牛奶，不含糖漿"}}}},
    "手动添加一项" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Add Manually"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"手動新增一項"}}}},
    "允许云端分析这张照片？" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allow Cloud Analysis of This Photo?"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"允許雲端分析這張照片？"}}}},
    "照片和当前草稿已保留，尚未发送到云端。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The photo and current draft are still here and have not been sent to the cloud."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"照片和目前的草稿已保留，尚未傳送到雲端。"}}}},
    "允许并开始识别" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allow and Start Recognition"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"允許並開始辨識"}}}},
    "识别会通过你的 Mac mini 将照片发送到 ChatGPT/OpenAI 云端处理。桥接使用 --ephemeral 只表示本地 Codex 会话不保留，不代表照片未上传或云端未处理。你可以稍后在本页撤销授权。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recognition sends the photo through your Mac mini to ChatGPT/OpenAI for cloud processing. The bridge’s --ephemeral option only means the local Codex session is not retained; it does not mean the photo was not uploaded or processed in the cloud. You can revoke access later on this page."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"辨識會透過你的 Mac mini 將照片傳送到 ChatGPT/OpenAI 雲端處理。橋接使用 --ephemeral 只表示本機 Codex 工作階段不保留，不代表照片未上傳或未由雲端處理。你之後可在本頁撤銷授權。"}}}},
    "已允许通过 Mac mini 发送照片到 ChatGPT/OpenAI 云端分析" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Photos may be sent through your Mac mini to ChatGPT/OpenAI for cloud analysis"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已允許透過 Mac mini 將照片傳送到 ChatGPT/OpenAI 雲端分析"}}}},
    "撤销云端照片识别授权" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Revoke Cloud Photo Recognition Access"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"撤銷雲端照片辨識授權"}}}},
    "已撤销授权；以后识别前会再次征求同意。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Access revoked. You’ll be asked again before future recognition."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已撤銷授權；之後辨識前會再次徵求同意。"}}}},
    "真实桥接验收：Mac mini + ChatGPT 订阅" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Live bridge check: Mac mini + ChatGPT subscription"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"真實橋接驗收：Mac mini + ChatGPT 訂閱"}}}},
    "演示识别结果，仅用于验证交互" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Demo result for interaction testing only"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"示範辨識結果，僅用於驗證互動"}}}},
    "餐盘、菜单或账单照片" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Meal, Menu, or Receipt Photo"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"餐盤、菜單或帳單照片"}}}},
    "照片已准备" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Photo Ready"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"照片已準備"}}}},
    "识别结果已显示在下方，可直接确认或修改" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Results appear below. Confirm or edit them."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"辨識結果顯示於下方，可直接確認或修改"}}}},
    "拍餐盘或餐厅账单" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Photograph a Meal or Restaurant Receipt"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"拍攝餐盤或餐廳帳單"}}}},
    "正在快速处理照片…" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Preparing Photo…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在快速處理照片…"}}}},
    "停止等待，保留本次照片" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Stop Waiting and Keep This Photo"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"停止等待並保留這次的照片"}}}},
    "重试识别" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Retry Recognition"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"重試辨識"}}}},
    "不拍照，直接手动填写" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter Manually Without a Photo"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"不拍照，直接手動填寫"}}}},
    "食物名称" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Food Name"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"食物名稱"}}}},
    "份量（如：约 180 克）" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Portion (for example, about 180 g)"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"份量（例如：約 180 克）"}}}},
    "请核对份量" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Check Portion"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請核對份量"}}}},
    "合理范围" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Estimated Range"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"合理範圍"}}}},
    "添加遗漏食物" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Add Missing Food"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"新增遺漏的食物"}}}},
    "账单菜品 · 请确认实际吃了多少" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Receipt Items · Confirm What You Ate"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"帳單餐點 · 請確認實際吃了多少"}}}},
    "识别结果 · 请确认份量" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recognition Result · Check Portions"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"辨識結果 · 請確認份量"}}}},
    "账单只能提供菜名和购买数量，看不到实际大小、烹调油、剩菜或谁吃了哪一份。整单比例和逐项修正都会同比调整已有估算，最终以你确认的内容保存。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A receipt only shows item names and quantities. It cannot show actual sizes, cooking oil, leftovers, or who ate each item. Whole-order shares and item edits scale the existing estimates; the values you confirm here are saved."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"帳單只能提供餐點名稱和購買數量，看不到實際大小、烹調油、剩菜或誰吃了哪一份。整張訂單比例和逐項修正都會同比調整現有估算，最後會儲存你確認的內容。"}}}},
    "照片识别只能提供估算。快捷倍数按原识别值同比调整已有营养，未知营养不会补填；油量会单独标为估算，酱汁不会自动估算。最终记录使用你在这里确认后的数值。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Photo recognition provides estimates only. Quick multipliers scale known nutrition values without inventing missing ones; oil is marked as an estimate and sauce is never estimated automatically. The values you confirm here are saved."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"照片辨識只能提供估算。快速倍數會按原辨識值同比調整已有營養，不會補造未知營養；油量會另外標為估算，醬汁不會自動估算。最後會記錄你在此確認的數值。"}}}},
    "已识别为账单或菜单" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recognized as a Receipt or Menu"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已辨識為帳單或菜單"}}}},
    "下面先按整张账单列出。你大约吃了这份订单的多少？" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The full order is listed below. About how much of it did you eat?"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"下方先列出整張帳單。你大約吃了這份訂單的多少？"}}}},
    "整单食用比例" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Whole-order share"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"整張訂單食用比例"}}}},
    "选择后会按该比例调整账单中所有识别项目" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Selecting this scales every recognized receipt item by that share"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"選擇後會按此比例調整帳單中所有辨識項目"}}}},
    "我已逐项核对" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"I Reviewed Each Item"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"我已逐項核對"}}}},
    "选完还可以逐项删除、改热量，或把某一道改回整份。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"You can still remove items, edit calories, or restore an item to a full portion."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"選完後仍可逐項刪除、修改熱量，或把某一道改回整份。"}}}},
    "没有额外油酱" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No Extra Oil or Sauce"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"沒有額外油或醬汁"}}}},
    "加 1 茶匙油" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Add 1 tsp Oil"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"加 1 茶匙油"}}}},
    "酱汁另算" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Add Sauce Separately"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"醬汁另算"}}}},
    "原估算差不多" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Original Estimate Is Close"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"原估算差不多"}}}},
    "约 ½ 份" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"About ½ Serving"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"約 ½ 份"}}}},
    "约 1½ 份" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"About 1½ Servings"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"約 1½ 份"}}}},
    "只确认这一项" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Confirm Just This Item"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"只確認這一項"}}}},
    "无需多角度拍摄；不确定时可直接编辑、重拍或稍后确认。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No extra angles are required. If unsure, edit it, retake the photo, or confirm later."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無需多角度拍攝；不確定時可直接編輯、重拍或稍後確認。"}}}},
    "快捷修正（均可撤销）" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Quick Adjustments (Undoable)"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"快速修正（皆可復原）"}}}},
    "没有识别到明确的食物或账单菜品，请重拍、补全账单画面，或直接手动填写。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No clear food or receipt items were found. Retake the photo, include the full receipt, or enter the food manually."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"未辨識到明確的食物或帳單餐點，請重拍、補全帳單畫面，或直接手動填寫。"}}}},
    "整单按" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Whole order:"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"整張訂單按"}}}},
    "正在生成演示识别结果…" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Generating Demo Result…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在產生示範辨識結果…"}}}},
    "正在通过 Mac mini 识别，通常约 20 秒…" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recognizing through Mac mini, usually about 20 seconds…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在透過 Mac mini 辨識，通常約 20 秒…"}}}},
    "识别把握较高" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"High Confidence"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"辨識把握較高"}}}},
    "识别把握一般" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Medium Confidence"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"辨識把握一般"}}}},
    "识别把握较低" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Low Confidence"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"辨識把握較低"}}}},
    "当前照片和已识别结果仍在本页，可停止等待后直接修改或保存。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The current photo and recognized results are still on this page. Stop waiting to edit or save them."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"目前的照片與辨識結果仍在本頁，可停止等待後直接修改或儲存。"}}}},
    "当前照片仍保留在本页，可重试识别、重拍或直接手动填写。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The current photo is still on this page. Try recognition again, retake it, or enter the food manually."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"目前的照片仍保留在本頁，可重試辨識、重拍或直接手動填寫。"}}}},
    "识别仍在继续。本次照片会保留在本页；你可以继续等待，或停止等待后重试。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recognition is still running. This photo will stay on this page; you can keep waiting or stop and retry."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"辨識仍在繼續。這次的照片會保留在本頁；你可以繼續等待，或停止等待後重試。"}}}},
    "已停止等待。当前照片仍在本页，随时可以重试、重拍或手动填写。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Stopped waiting. The current photo is still on this page, so you can retry, retake it, or enter the food manually at any time."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已停止等待。目前的照片仍在本頁，隨時可以重試、重拍或手動填寫。"}}}},
    "有额外的烹调油或酱汁吗？" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"— does it have extra cooking oil or sauce?"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"有額外的烹調油或醬汁嗎？"}}}},
    "的份量更接近哪一个？" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"— which portion is closest?"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"的份量更接近哪一個？"}}}},
    "全部" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"All"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"全部"}}}},
    "四分之一" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"One quarter"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"四分之一"}}}},
    "二分之一" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"One half"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"二分之一"}}}},
    "四分之三" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Three quarters"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"四分之三"}}}},
    "整单" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Whole order"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"整張訂單"}}}},
    "整单食用比例：按原识别结果 ×{factor} 估算；请核对实际吃到的菜品与份量。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Whole-order share: estimated from the original result ×{factor}. Check the items and portions you actually ate."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"整張訂單食用比例：按原辨識結果 ×{factor} 估算；請核對實際吃到的餐點與份量。"}}}},
    "原份" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Original portion"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"原份"}}}},
    "快捷修正：按原识别结果 ×{factor} 估算；可撤销或手动修改。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Quick adjustment: estimated from the original result ×{factor}. You can undo or edit it manually."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"快速修正：按原辨識結果 ×{factor} 估算；可復原或手動修改。"}}}},
    "加 1 汤匙油" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Add 1 tbsp Oil"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"加 1 湯匙油"}}}},
    "1 茶匙（约 5 ml）" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"1 tsp (about 5 ml)"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"1 茶匙（約 5 ml）"}}}},
    "1 汤匙（约 15 ml）" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"1 tbsp (about 15 ml)"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"1 湯匙（約 15 ml）"}}}},
    "酱汁（待确认）" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Sauce (Check Needed)"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"醬汁（待確認）"}}}},
    "请填写实际份量" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter the Actual Portion"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請填寫實際份量"}}}},
    "未估算酱汁热量；请按包装、食谱或实际用量填写。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Sauce calories were not estimated. Use the package, recipe, or actual amount."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"尚未估算醬汁熱量；請按包裝、食譜或實際用量填寫。"}}}},
    "烹调油（估算）" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cooking Oil (Estimate)"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"烹調油（估算）"}}}},
    "快捷估算：按常见食用油计算；请按实际用量编辑，可撤销。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Quick estimate based on common cooking oil. Edit it to match the actual amount; you can undo it."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"快速估算：按常見食用油計算；請依實際用量編輯，可復原。"}}}},
    "请等待照片处理或识别完成" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Wait for photo processing or recognition to finish"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請等待照片處理或辨識完成"}}}},
    "请补全食物名称和大于 0 的热量" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter a food name and calories greater than 0"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請補全食物名稱和大於 0 的熱量"}}}},
    "账单记录前，请选择整单食用比例（包括“全部”），或确认已逐项核对" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Before logging a receipt, choose the whole-order share (including “All”) or confirm that you reviewed each item"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"記錄帳單前，請選擇整張訂單的食用比例（包括「全部」），或確認你已逐項核對"}}}},
    "这张照片无法发送，请重拍或换一张照片。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This photo cannot be sent. Retake it or choose another photo."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"這張照片無法傳送，請重拍或換一張照片。"}}}},
    "暂时连不上 Mac mini。请确认 Mac mini 已开机、已登录 ChatGPT，并且手机已连接 Tailscale。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Can’t reach your Mac mini. Make sure it is on, signed in to ChatGPT, and your phone is connected to Tailscale."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"暫時無法連上 Mac mini。請確認 Mac mini 已開機、已登入 ChatGPT，且手機已連接 Tailscale。"}}}},
    "当前设备不在允许的 Tailscale 账户中，Mac mini 已拒绝识别请求。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This device is not in the allowed Tailscale account, so the Mac mini rejected the request."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"目前的裝置不在允許的 Tailscale 帳戶中，Mac mini 已拒絕辨識要求。"}}}},
    "Mac mini 正在识别上一张照片，请稍等十几秒后重试。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Mac mini is still recognizing the previous photo. Wait a few seconds and try again."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Mac mini 正在辨識上一張照片，請稍等十幾秒後再試。"}}}},
    "Mac mini 上的 ChatGPT 登录或订阅额度暂时不可用，请在 Mac mini 的 ChatGPT 中检查登录状态。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"ChatGPT sign-in or subscription usage is temporarily unavailable on the Mac mini. Check the ChatGPT sign-in there."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Mac mini 上的 ChatGPT 登入或訂閱額度暫時無法使用，請在 Mac mini 的 ChatGPT 中檢查登入狀態。"}}}},
    "这次识别等待超时，请保持 Mac mini 在线后重试。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recognition timed out. Keep your Mac mini online and try again."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"這次辨識等待逾時，請讓 Mac mini 保持連線後再試。"}}}},
    "Mac mini 返回的识别结果不完整，请重试或手动填写。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Mac mini returned an incomplete result. Try again or enter the food manually."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Mac mini 回傳的辨識結果不完整，請重試或手動填寫。"}}}},
    "Mac mini 识别失败，请重试或手动填写。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Mac mini recognition failed. Try again or enter the food manually."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Mac mini 辨識失敗，請重試或手動填寫。"}}}},
    "已选择" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Selected"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已選擇"}}}},
    "未选择" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Not selected"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"未選擇"}}}},
    "我已逐项核对，已确认" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"I reviewed each item, confirmed"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"我已逐項核對，已確認"}}}},
    "我已逐项核对，未确认" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"I reviewed each item, not confirmed"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"我已逐項核對，未確認"}}}},
    "可拍餐盘、菜单或餐厅账单；真机打开会直接进入相机" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Photograph a meal, menu, or restaurant receipt. On iPhone, the camera opens immediately."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"可拍攝餐盤、菜單或餐廳帳單；在 iPhone 上開啟時會直接進入相機"}}}},
    "无法读取这张照片，请换一张重试" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This photo couldn’t be read. Try another one."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法讀取這張照片，請換一張重試"}}}},
    "照片缩放失败，请重新拍摄" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Couldn’t resize the photo. Take it again."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"照片縮放失敗，請重新拍攝"}}}},
    "照片处理失败，请重新拍摄" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Couldn’t process the photo. Take it again."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"照片處理失敗，請重新拍攝"}}}},
    "Mac mini 本地识别尚未接入。照片已保留，你可以先手动补充食物；接入后这里会自动识别，不会跳转到 ChatGPT。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Mac mini recognition isn’t connected yet. The photo is still here, so you can add food manually. Once connected, recognition runs here without opening ChatGPT."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Mac mini 本機辨識尚未接入。照片已保留，你可以先手動補充食物；接入後會在此自動辨識，不會跳轉到 ChatGPT。"}}}},
    "演示：模拟识别失败，用于验证照片保留和重试流程。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Demo: simulated recognition failure for testing photo retention and retry."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"示範：模擬辨識失敗，用於驗證照片保留與重試流程。"}}}},
    "尚未配置私有识别桥接。你仍可手动记录；请在设置中填写自己的 HTTPS 桥接地址，不要填写 API Key。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No private recognition bridge is configured. You can still log manually; enter your own HTTPS bridge address in Settings, never an API key."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"尚未設定私人辨識橋接。你仍可手動記錄；請在設定中填寫自己的 HTTPS 橋接位址，不要填寫 API Key。"}}}},
    "%@必须是有效数字。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ must be a valid number."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"%@必須是有效數字。"}}}},
    "%@超出合理的 %@ 范围。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ is outside the reasonable %@ range."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"%@超出合理的 %@ 範圍。"}}}},
    "体脂率需大于 3% 且小于 70%，或留空。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Body fat must be greater than 3% and less than 70%, or leave it blank."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"體脂率必須大於 3% 且小於 70%，或留白。"}}}},
    "无法请求 Apple 健康授权。请到系统设置检查权限后重试。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Couldn’t request Apple Health access. Check permissions in Settings and try again."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法要求 Apple 健康授權。請到系統設定檢查權限後再試。"}}}},
    "此设备支持" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Supported on this device"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"此裝置支援"}}}},
    "此设备不支持" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Not supported on this device"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"此裝置不支援"}}}},
    "最近一次授权请求失败，请检查系统设置。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The last authorization request failed. Check System Settings."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"最近一次授權要求失敗，請檢查系統設定。"}}}}
  },
  "version" : "1.0"
}
