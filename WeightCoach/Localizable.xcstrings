    "当前体重" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Current Weight"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"目前體重"}}}},
    "距离目标" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"To Goal"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"距離目標"}}}},
    "体脂率" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Body Fat"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"體脂率"}}}},
    "预计达成" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Projected Goal"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"預計達成"}}}},
    "体重趋势" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Weight Trend"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"體重趨勢"}}}},
    "暂无体重数据" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No Weight Data"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"尚無體重資料"}}}},
    "点右上角 + 记录一次体重" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Tap + in the top right to log your weight"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"點右上角的 + 記錄一次體重"}}}},
    "虚线为按计划的目标轨迹" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The dashed line shows your planned goal path"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"虛線為依計畫的目標軌跡"}}}},
    "体脂率趋势" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Body Fat Trend"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"體脂率趨勢"}}}},
    "最近记录" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recent Entries"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"最近記錄"}}}},
    "测量数据" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Measurements"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"測量資料"}}}},
    "体脂率（可选）" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Body Fat (Optional)"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"體脂率（選填）"}}}},
    "记录体重" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Log Weight"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"記錄體重"}}}},
    "已保存到 App" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Saved in the App"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已儲存到 App"}}}},
    "这次未能写入 Apple 健康，本地体重记录仍然保留。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This entry couldn’t be written to Apple Health. Your local weight entry is still saved."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"這次無法寫入 Apple 健康，本機體重記錄仍會保留。"}}}},
    "本地保存失败，请重试。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Couldn’t save locally. Please try again."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"本機儲存失敗，請再試一次。"}}}},
    "饮食记录" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Food Log"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"飲食記錄"}}}},
    "当日合计" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Daily Total"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"當日合計"}}}},
    "还没有记录" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Nothing Logged Yet"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"還沒有記錄"}}}},
    "用下方按钮记录你吃的东西" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use a button below to log what you ate"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"用下方按鈕記錄你吃的東西"}}}},
    "拍照识别" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Scan Food"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"拍照辨識"}}}},
    "扫码" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Barcode"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"掃碼"}}}},
    "手动" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Manual"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"手動"}}}},
    "重试健康同步" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Retry Health Sync"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"重試健康同步"}}}},
    "Apple 健康同步中" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Syncing to Apple Health"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在同步至 Apple 健康"}}}},
    "已保存到 App · 健康同步失败" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Saved in App · Health Sync Failed"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已儲存到 App · 健康同步失敗"}}}},
    "已同步到 Apple 健康" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Synced to Apple Health"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已同步至 Apple 健康"}}}},
    "运动补记" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Manual Exercise"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"補記運動"}}}},
    "只补记 Apple 健康没有完整记录的运动。稍后同步到的健康数据会自动从补差中扣除。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Only log exercise that Apple Health didn’t fully capture. Health data synced later will automatically be deducted from the supplement."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"只補記 Apple 健康未完整記錄的運動。稍後同步的健康資料會自動從補差中扣除。"}}}},
    "篮球时长请填真正活动的分钟数，不包含坐场边、长时间休息或聊天。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"For basketball, enter only the minutes you were actually active, excluding time on the bench, long breaks, or chatting."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"籃球時長請填真正活動的分鐘數，不含坐場邊、長時間休息或聊天。"}}}},
    "避免重复计算" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Avoid Double Counting"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"避免重複計算"}}}},
    "手动记录不会写回 Apple 健康。热量是基于体重与运动强度的群体估算，不是精密测量。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Manual entries aren’t written to Apple Health. Calories are population estimates based on weight and intensity, not precise measurements."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"手動記錄不會寫回 Apple 健康。熱量是依體重與運動強度的群體估算，並非精密測量。"}}}},
    "还没有运动补记" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No Manual Exercise Yet"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"還沒有補記運動"}}}},
    "不戴手表打球或跑步后，点右上角 + 记录" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"After playing or running without your watch, tap + in the top right"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"沒戴手錶打球或跑步後，點右上角的 + 記錄"}}}},
    "最近补记" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recent Manual Entries"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"最近補記"}}}},
    "记录运动" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Log Exercise"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"記錄運動"}}}},
    "今天的手动运动" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Today’s Manual Exercise"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"今天的手動運動"}}}},
    "自动去重" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Auto-Deduplicated"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"自動去重"}}}},
    "仅展示" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Display Only"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"僅顯示"}}}},
    "估算活动" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Estimated"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"估算活動"}}}},
    "健康已记" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"In Health"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"健康已記錄"}}}},
    "实际补入" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Added"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"實際補入"}}}},
    "未计入预算" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Not in Budget"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"未計入預算"}}}},
    "设置中当前使用活动系数模式，手动运动不会额外增加今天的热量预算。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Activity-factor mode is enabled in Settings, so manual exercise won’t increase today’s calorie budget."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"設定中目前使用活動係數模式，手動運動不會額外增加今天的熱量預算。"}}}},
    "活动千卡" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"active kcal"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"活動大卡"}}}},
    "运动类型" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Exercise Type"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"運動類型"}}}},
    "类型" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Type"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"類型"}}}},
    "强度" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Intensity"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"強度"}}}},
    "时间与体重" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Time & Weight"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"時間與體重"}}}},
    "开始时间" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Start Time"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"開始時間"}}}},
    "当时体重" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Weight at the Time"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"當時體重"}}}},
    "结束时间不能晚于现在，请调整开始时间或活动时长。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The end time can’t be in the future. Adjust the start time or duration."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"結束時間不能晚於現在，請調整開始時間或活動時長。"}}}},
    "预计净活动热量" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Estimated Net Active Energy"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"預估淨活動熱量"}}}},
    "已减去同一时段原本会消耗的静息热量" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Resting energy for the same period has been deducted"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已扣除同一時段原本會消耗的靜息熱量"}}}},
    "采用 2024 Adult Compendium 的 MET 群体估算。篮球请只填真正活动时间；App 会再扣除同一时段 Apple 健康已经记录的活动能量。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Uses population MET estimates from the 2024 Adult Compendium. For basketball, enter only active time; the app will deduct activity energy already recorded by Apple Health for the same period."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"採用 2024 Adult Compendium 的 MET 群體估算。籃球請只填真正活動時間；App 會再扣除同一時段 Apple 健康已記錄的活動能量。"}}}},
    "补记运动" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Add Manual Exercise"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"補記運動"}}}},
    "请检查体重、时长和运动强度。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Check the weight, duration, and exercise intensity."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請檢查體重、時長和運動強度。"}}}},
    "结束时间不能晚于现在。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The end time can’t be in the future."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"結束時間不能晚於現在。"}}}},
    "这段时间已有手动运动记录，请调整时间，避免重复计算。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A manual exercise entry already overlaps this time. Adjust the time to avoid double counting."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"這段時間已有手動運動記錄，請調整時間以免重複計算。"}}}},
    "添加食物" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Add Food"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"新增食物"}}}},
    "确认食物" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Confirm Food"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"確認食物"}}}},
    "输入一个字，如：西、虾、rice" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Type a letter, e.g. b, s, rice"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"輸入一個字，例如：西、蝦、rice"}}}},
    "清除搜索" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Clear Search"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"清除搜尋"}}}},
    "输入一个字就会立即出现匹配项；点选后按实际克重自动换算。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Matches appear as you type. Select one and enter the actual weight for automatic calculation."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"輸入一個字就會立即顯示符合項目；點選後依實際克重自動換算。"}}}},
    "所有数值按可食部分重量估算，不包含额外用油或酱汁。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"All values are estimated by edible weight and exclude extra oil or sauce."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"所有數值依可食部分重量估算，不含額外用油或醬汁。"}}}},
    "换一种食物" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose a Different Food"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"換一種食物"}}}},
    "实际吃了多少" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Amount Eaten"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"實際吃了多少"}}}},
    "常用份量" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Common Portions"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"常用份量"}}}},
    "按去壳、去皮后的可食部分估算；大小不同，可以继续修改克重。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Estimated by edible weight after removing the shell or peel. Adjust the grams for size differences."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"依去殼、去皮後的可食部分估算；大小不同，可繼續修改公克數。"}}}},
    "可食部分重量" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Edible Weight"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"可食部分重量"}}}},
    "重量" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Weight"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"重量"}}}},
    "餐次" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Meal"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"餐次"}}}},
    "自动换算" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Calculated Nutrition"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"自動換算"}}}},
    "通用食物参考值；品牌、品种和烹调方式会造成差异" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Generic reference values; brands, varieties, and preparation methods vary"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"通用食物參考值；品牌、品種與烹調方式會造成差異"}}}},
    "请输入 0–10,000 克之间的有效重量" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter a valid weight from 0 to 10,000 g"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請輸入 0–10,000 克之間的有效重量"}}}},
    "品牌饮品核对" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Branded Drink Check"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"品牌飲品核對"}}}},
    "星巴克定制饮品" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Customized Starbucks Drink"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"星巴克客製飲品"}}}},
    "按杯型、最终糖浆泵数和蛋白冷泡沫核对" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Check size, final syrup pumps, and protein cold foam"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"依杯型、最終糖漿泵數和蛋白冷泡沫核對"}}}},
    "常见食物" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Common Foods"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"常見食物"}}}},
    "没有匹配的常见食物" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No Common Food Matches"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"沒有符合的常見食物"}}}},
    "仍然可以保留这个名称，自行填写热量与营养。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"You can keep this name and enter calories and nutrients manually."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"仍可保留這個名稱，自行填寫熱量與營養。"}}}},
    "参考库完全离线，无需账号或 API Key；包装食品仍建议扫描条形码或营养标签。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The reference catalog works fully offline with no account or API key. For packaged foods, scan the barcode or nutrition label."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"參考資料庫完全離線，不需帳號或 API Key；包裝食品仍建議掃描條碼或營養標示。"}}}},
    "选择后输入重量" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Select, then enter the weight"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"選擇後輸入重量"}}}},
    "热量" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Calories"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"熱量"}}}},
    "蛋白质" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Protein"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"蛋白質"}}}},
    "碳水" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Carbs"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"碳水"}}}},
    "脂肪" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Fat"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"脂肪"}}}},
    "自行填写热量与营养" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter Calories & Nutrition Manually"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"自行填寫熱量與營養"}}}},
    "食物信息" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Food Details"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"食物資訊"}}}},
    "名称（如：牛肉面）" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Name (e.g. beef noodles)"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"名稱（例如：牛肉麵）"}}}},
    "热量（千卡）" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Calories (kcal)"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"熱量（大卡）"}}}},
    "份量描述（可选，如：一大碗）" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Portion (optional, e.g. large bowl)"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"份量描述（選填，例如：一大碗）"}}}},
    "营养素（可选，克）" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Nutrients (Optional, g)"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"營養素（選填，克）"}}}},
    "碳水化合物" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Carbohydrates"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"碳水化合物"}}}},
    "营养素请填写大于或等于 0 的数字；留空表示不知道" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter nutrient values of 0 or greater. Leave blank if unknown."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"營養素請填寫大於或等於 0 的數字；留白表示未知"}}}},
    "咖啡因（毫克）" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Caffeine (mg)"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"咖啡因（毫克）"}}}},
    "咖啡因（可选）" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Caffeine (Optional)"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"咖啡因（選填）"}}}},
    "留空表示不知道；明确不含咖啡因可填写 0。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Leave blank if unknown. Enter 0 only if it is known to be caffeine-free."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"留白表示未知；確定不含咖啡因時可填 0。"}}}},
    "自行填写" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Manual Entry"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"自行填寫"}}}},
    "扫码记录" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Scan Barcode"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"掃碼記錄"}}}},
    "对准商品条形码" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Point at the Product Barcode"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"對準商品條碼"}}}},
    "相机扫码不可用" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Camera Scanning Unavailable"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"相機掃碼無法使用"}}}},
    "当前设备不支持实时扫码或未授权相机。可以在下方手动输入条形码数字。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Live scanning isn’t available or camera access wasn’t granted. Enter the barcode number below."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"目前裝置不支援即時掃碼或未授權相機。可在下方手動輸入條碼數字。"}}}},
    "正在查询商品信息…" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Looking Up Product…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在查詢商品資訊…"}}}},
    "扫描包装营养表" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Scan Nutrition Label"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"掃描包裝營養標示"}}}},
    "只在本机识别；确认后会按这个条码保存，下次直接秒开。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Processed only on this device. After confirmation it is saved for this barcode for instant access next time."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"只在本機辨識；確認後會依此條碼儲存，下次可立即開啟。"}}}},
    "手动输入条形码（UPC/EAN）" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter Barcode (UPC/EAN)"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"手動輸入條碼（UPC/EAN）"}}}},
    "查询" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Look Up"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"查詢"}}}},
    "商品" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Product"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"商品"}}}},
    "本地秒开" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Saved Offline"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"本機秒開"}}}},
    "重新扫描" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Scan Again"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"重新掃描"}}}},
    "这次吃了多少" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Amount Eaten"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"這次吃了多少"}}}},
    "商品数据不足，无法可靠换算。请重新扫描或改用手动记录。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"There isn’t enough product data for a reliable calculation. Scan again or use manual entry."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"商品資料不足，無法可靠換算。請重新掃描或改用手動記錄。"}}}},
    "单位" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unit"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"單位"}}}},
    "数量" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Quantity"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"數量"}}}},
    "自动计算" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Calculated Total"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"自動計算"}}}},
    "本次摄入" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This Entry"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"本次攝取"}}}},
    "正在保存…" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Saving…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在儲存…"}}}},
    "当前份量无法可靠换算，请选择可用单位和数量。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This portion can’t be calculated reliably. Choose an available unit and quantity."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"目前份量無法可靠換算，請選擇可用的單位與數量。"}}}},
    "扫描营养表" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Scan Nutrition Label"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"掃描營養標示"}}}},
    "让营养表占满画面，保持镜头平行" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Fill the frame with the label and keep the camera parallel"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"讓營養標示充滿畫面，鏡頭保持平行"}}}},
    "拍摄包装营养表" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Photograph Nutrition Label"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"拍攝包裝營養標示"}}}},
    "拍摄后立即在本机识别文字" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Text is recognized on this device immediately after capture"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"拍攝後立即在本機辨識文字"}}}},
    "本机识别，不上传照片" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Processed on device. Photos aren’t uploaded."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"本機辨識，不上傳照片"}}}},
    "识别值必须由你确认后才会按条码保存" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recognized values are saved for this barcode only after you confirm them"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"辨識數值須由你確認後才會依條碼儲存"}}}},
    "包装上的 Nutrition Facts" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Nutrition Facts on the Package"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"包裝上的 Nutrition Facts"}}}},
    "正在本机读取营养数字…" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reading Nutrition Values On Device…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在本機讀取營養數值…"}}}},
    "通常只需几秒" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This usually takes only a few seconds"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"通常只需幾秒"}}}},
    "拍摄完整营养表" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Photograph the Full Label"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"拍攝完整營養標示"}}}},
    "需要重新拍摄" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Retake Needed"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"需要重新拍攝"}}}},
    "靠近包装，让标题、每份大小、热量和三大营养素都进入画面。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Move closer so the title, serving size, calories, and all three macros are in frame."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"靠近包裝，讓標題、每份大小、熱量和三大營養素都進入畫面。"}}}},
    "本机 OCR 已完成" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"On-Device OCR Complete"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"本機 OCR 已完成"}}}},
    "演示 OCR 已完成" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Demo OCR Complete"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"示範 OCR 已完成"}}}},
    "只需核对标橙字段，然后继续选择食用量" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Check the orange fields, then continue to choose the amount eaten"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"只需核對橙色欄位，再繼續選擇食用量"}}}},
    "拍照" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Take Photo"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"拍照"}}}},
    "重拍" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Retake"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"重拍"}}}},
    "从相册选择" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose from Photos"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"從相簿選擇"}}}},
    "商品名称" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Product Name"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"商品名稱"}}}},
    "品牌（可不填）" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Brand (Optional)"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"品牌（選填）"}}}},
    "条码" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Barcode"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"條碼"}}}},
    "使用标签哪一列" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Which Label Column to Use"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"使用標示的哪一欄"}}}},
    "这些数值是" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"These Values Are"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"這些數值是"}}}},
    "每份说明（如 5 块 / 85g）" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Serving description (e.g. 5 pieces / 85 g)"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"每份說明（例如 5 塊 / 85g）"}}}},
    "份量换算信息" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Portion Conversion Details"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"份量換算資訊"}}}},
    "每份重量" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Weight per Serving"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"每份重量"}}}},
    "每份体积" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Volume per Serving"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"每份體積"}}}},
    "每份数量" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Items per Serving"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"每份數量"}}}},
    "每包份数" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Servings per Package"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"每包份數"}}}},
    "营养基准与份量" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Nutrition Basis & Portion"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"營養基準與份量"}}}},
    "这里决定之后按克、份、毫升、个或整包换算；程序不会猜缺失数据。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This controls later calculations by gram, serving, milliliter, item, or package. Missing data won’t be guessed."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"這裡決定之後依克、份、毫升、個或整包換算；程式不會猜測缺失資料。"}}}},
    "其他营养素" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Other Nutrients"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"其他營養素"}}}},
    "我已核对标橙字段" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"I checked the orange fields"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"我已核對橙色欄位"}}}},
    "保存前确认" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Confirm Before Saving"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"儲存前確認"}}}},
    "正在保存商品…" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Saving Product…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在儲存商品…"}}}},
    "确认并继续记录" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Confirm & Continue"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"確認並繼續記錄"}}}},
    "需要核对" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Needs Review"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"需要核對"}}}},
    "必填" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Required"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"必填"}}}},
    "没有读到可用的营养数字，请靠近后重拍。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No usable nutrition values were found. Move closer and retake the photo."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"沒有讀到可用的營養數值，請靠近後重拍。"}}}},
    "营养基准" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Nutrition Basis"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"營養基準"}}}},
    "份量信息" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Portion Details"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"份量資訊"}}}},
    "请确认 OCR 结果" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Confirm the OCR Results"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請確認 OCR 結果"}}}},
    "请先核对并确认标橙字段" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Check and confirm the orange fields first"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請先核對並確認橙色欄位"}}}},
    "请填写商品名称" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter a product name"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請填寫商品名稱"}}}},
    "请确认热量是大于 0 的数字" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Confirm that calories are a number greater than 0"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請確認熱量為大於 0 的數字"}}}},
    "营养数值只能填写非负数字" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Nutrient values must be nonnegative numbers"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"營養數值只能填寫非負數"}}}},
    "包装食品" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Packaged Food"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"包裝食品"}}}},
    "每份" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Per Serving"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"每份"}}}},
    "每 100 克" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Per 100 g"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"每 100 克"}}}},
    "每 100 毫升" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Per 100 mL"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"每 100 毫升"}}}},
    "整包" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Whole Package"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"整包"}}}},
    "每个" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Per Item"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"每個"}}}},
    "星巴克定制核对" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Starbucks Customization Check"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"星巴克客製核對"}}}},
    "24 fl oz · 4 份浓缩" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"24 fl oz · 4 espresso shots"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"24 fl oz · 4 份濃縮"}}}},
    "Starbucks 标准显示" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Starbucks Standard Listing"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Starbucks 標準顯示"}}}},
    "咖啡因" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Caffeine"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"咖啡因"}}}},
    "当前建议记录" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recommended Entry"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"目前建議記錄"}}}},
    "饮品" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Drink"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"飲品"}}}},
    "标准热量不会随 App 内自定义实时变化；下面按你最终喝到的配方重新估算。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The standard calorie listing doesn’t update with in-app customizations. The estimate below uses the drink you actually ordered."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"標準熱量不會隨 App 內客製內容即時變化；下方會依你最後喝到的配方重新估算。"}}}},
    "糖浆" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Syrup"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"糖漿"}}}},
    "这里填最终总泵数，不是“额外再加几泵”。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter the final total pump count, not the number of extra pumps."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"這裡填最終總泵數，不是「額外再加幾泵」。"}}}},
    "加料" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Add-ons"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"加料"}}}},
    "此冷泡沫没有单独公开的官方完整营养值；按 Starbucks 官方相邻蛋白冷泡沫饮品推算。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Starbucks doesn’t publish complete nutrition for this cold foam alone, so this estimate uses similar official protein cold-foam drinks."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"此冷泡沫沒有單獨公開的官方完整營養值；依 Starbucks 官方相近蛋白冷泡沫飲品推算。"}}}},
    "估算拆分" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Estimate Breakdown"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"估算拆分"}}}},
    "标准饮品" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Standard Drink"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"標準飲品"}}}},
    "糖浆变化" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Syrup Change"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"糖漿變化"}}}},
    "蛋白冷泡沫" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Protein Cold Foam"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"蛋白冷泡沫"}}}},
    "蛋白冷泡沫（推算）" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Protein Cold Foam (Estimated)"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"蛋白冷泡沫（推算）"}}}},
    "建议记录" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recommended Entry"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"建議記錄"}}}},
    "蛋白质（估算）" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Protein (Estimated)"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"蛋白質（估算）"}}}},
    "碳水（估算）" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Carbs (Estimated)"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"碳水（估算）"}}}},
    "脂肪（估算）" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Fat (Estimated)"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"脂肪（估算）"}}}},
    "营养素" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Nutrients"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"營養素"}}}},
    "咖啡因主要由浓缩份数决定；减少糖浆不会降低咖啡因。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Caffeine mostly depends on the number of espresso shots. Reducing syrup doesn’t reduce caffeine."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"咖啡因主要由濃縮份數決定；減少糖漿不會降低咖啡因。"}}}},
    "记录前确认" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Confirm Before Logging"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"記錄前確認"}}}},
    "没有相机权限" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No Camera Access"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"沒有相機權限"}}}},
    "当前设备没有可用相机" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No Camera Available on This Device"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"目前裝置沒有可用相機"}}}},
    "相机启动失败" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Couldn’t Start Camera"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"相機啟動失敗"}}}},
    "拍照失败" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Couldn’t Take Photo"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"拍照失敗"}}}},
    "照片读取失败" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Couldn’t Read Photo"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"照片讀取失敗"}}}},
    "请在系统设置中允许「减重助手」使用相机。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allow WeightCoach to use the camera in Settings."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請在系統設定中允許「減重助手」使用相機。"}}}},
    "模拟器不提供相机，请在真机拍摄，或改用相册照片。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The simulator has no camera. Take a photo on a real device or choose one from Photos."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"模擬器不提供相機，請在實機拍攝，或改用相簿照片。"}}}},
    "请保持镜头稳定后重新拍摄。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Hold the camera steady and try again."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請保持鏡頭穩定後重新拍攝。"}}}},
    "对准食物，轻点拍摄" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Point at the food and tap to capture"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"對準食物，輕點拍攝"}}}},
    "拍摄食物照片" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Take Food Photo"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"拍攝食物照片"}}}},
    "拍摄后立即开始识别，不再显示确认页面" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recognition starts immediately after capture without another confirmation screen"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"拍攝後立即開始辨識，不再顯示確認頁面"}}}},
    "正在打开相机…" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Opening Camera…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在開啟相機…"}}}},
    "退出拍照" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Exit Camera"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"退出拍照"}}}},
    "关闭闪光灯" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Turn Flash Off"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"關閉閃光燈"}}}},
    "打开闪光灯" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Turn Flash On"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"開啟閃光燈"}}}},
    "当前相机没有闪光灯" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This camera has no flash"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"目前相機沒有閃光燈"}}}},
    "正在拍摄…" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Capturing…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在拍攝…"}}}},
    "相机不可用" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Camera Unavailable"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"相機無法使用"}}}},
    "打开系统设置" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open Settings"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"開啟系統設定"}}}},
    "相机输入或照片输出不可用，请重新打开拍照页。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Camera input or photo output is unavailable. Reopen the camera screen."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"相機輸入或照片輸出無法使用，請重新開啟拍照頁面。"}}}},
    "身体成分与校准" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Body Composition & Calibration"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"身體組成與校準"}}}},
    "Apple 健康 → 本地记录 → 校准体脂" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Apple Health → Local Entries → Calibrated Body Fat"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Apple 健康 → 本機記錄 → 校準體脂"}}}},
    "只有前两者都没有有效体脂时，才使用校准体脂计算 BMR。历史 DEXA 和其他肌肉口径都不会进入预算计算。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Calibrated body fat is used for BMR only when neither of the first two sources has valid data. Historical DEXA and other muscle measures never affect the budget."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"只有前兩者都沒有有效體脂時，才使用校準體脂計算 BMR。歷史 DEXA 與其他肌肉口徑都不會進入預算計算。"}}}},
    "当前校准兜底" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Current Calibration Fallback"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"目前校準備援"}}}},
    "体脂数据优先级" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Body Fat Data Priority"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"體脂資料優先順序"}}}},
    "当前校准" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Current Calibration"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"目前校準"}}}},
    "不同测量口径" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Different Measurement Definitions"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"不同測量口徑"}}}},
    "历史 DEXA" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Historical DEXA"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"歷史 DEXA"}}}},
    "日均摄入参考" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Daily Intake Reference"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"日均攝取參考"}}}},
    "这是个人参考，不会替代今日预算，也不会改变 TDEE 替代模型、动态缺口或安全下限。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This is a personal reference only. It doesn’t replace today’s budget or change the TDEE replacement model, dynamic deficit, or safety floor."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"這是個人參考，不會取代今日預算，也不會改變 TDEE 替代模型、動態缺口或安全下限。"}}}},
    "热量参考" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Calorie Reference"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"熱量參考"}}}},
    "此项按用户提供信息显示为约值" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Shown as an approximate value based on information you provided"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"此項依使用者提供的資訊顯示為約值"}}}},
    "口径说明" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Definition"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"口徑說明"}}}},
    "精确值" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Exact Value"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"精確值"}}}},
    "范围下限" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Range Minimum"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"範圍下限"}}}},
    "范围上限" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Range Maximum"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"範圍上限"}}}},
    "数值" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Values"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"數值"}}}},
    "只有范围时可将精确值留空；App 不会自动取中点。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"If you only have a range, leave the exact value blank. The app won’t assume the midpoint."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"只有範圍時可將精確值留白；App 不會自動取中點。"}}}},
    "来源" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Source"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"來源"}}}},
    "有测量日期" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Measurement Date Available"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"有測量日期"}}}},
    "测量日期" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Measurement Date"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"測量日期"}}}},
    "日期未提供；打开编辑页不会自动填成今天。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No date was provided. Opening this editor won’t set it to today."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"未提供日期；開啟編輯頁不會自動填成今天。"}}}},
    "来源与日期" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Source & Date"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"來源與日期"}}}},
    "口径、约值或其他说明" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Definition, approximation, or other notes"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"口徑、約值或其他說明"}}}},
    "备注" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Notes"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"備註"}}}},
    "清空此项" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Clear This Item"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"清除此項"}}}},
    "清空后会保持为空，不会在下次启动重新灌入默认值。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"After clearing, it stays empty and won’t be repopulated on the next launch."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"清空後會保持空白，不會在下次啟動時重新填入預設值。"}}}},
    "日均参考" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Daily Reference"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"日均參考"}}}},
    "仅用于显示个人参考；不进入 BMR、TDEE、动态缺口或今日预算。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Display-only personal reference. It doesn’t affect BMR, TDEE, the dynamic deficit, or today’s budget."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"僅用於顯示個人參考；不會進入 BMR、TDEE、動態缺口或今日預算。"}}}},
    "校准体脂率" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Calibrated Body Fat"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"校準體脂率"}}}},
    "校准脂肪量" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Calibrated Fat Mass"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"校準脂肪量"}}}},
    "完整去脂体重" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Total Fat-Free Mass"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"完整去脂體重"}}}},
    "DEXA 瘦软组织" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"DEXA Lean Soft Tissue"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"DEXA 瘦軟組織"}}}},
    "四肢瘦体重" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Appendicular Lean Mass"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"四肢瘦體重"}}}},
    "Fitdays 肌肉量" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Fitdays Muscle Mass"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Fitdays 肌肉量"}}}},
    "骨骼肌量" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Skeletal Muscle Mass"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"骨骼肌量"}}}},
    "历史体脂率" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Historical Body Fat"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"歷史體脂率"}}}},
    "历史脂肪量" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Historical Fat Mass"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"歷史脂肪量"}}}},
    "历史瘦软组织" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Historical Lean Soft Tissue"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"歷史瘦軟組織"}}}},
    "历史总重" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Historical Total Mass"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"歷史總重"}}}},
    "综合校准体脂；仅在健康与本地体脂都缺失时作为 BMR 兜底。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Combined calibrated body fat, used for BMR only when Health and local body-fat data are both unavailable."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"綜合校準體脂；僅在健康與本機體脂都缺失時作為 BMR 備援。"}}}},
    "身体中脂肪组织的质量。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The mass of fat tissue in the body."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"身體中脂肪組織的質量。"}}}},
    "全部非脂肪质量，包含骨矿物；不等同于肌肉量。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"All non-fat mass, including bone mineral; not the same as muscle mass."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"全部非脂肪質量，包含骨礦物；不等同於肌肉量。"}}}},
    "DEXA lean soft tissue，排除脂肪与骨矿物。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"DEXA lean soft tissue, excluding fat and bone mineral."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"DEXA lean soft tissue，排除脂肪與骨礦物。"}}}},
    "四肢 lean mass，是 DEXA 瘦软组织的子集。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Appendicular lean mass, a subset of DEXA lean soft tissue."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"四肢 lean mass，是 DEXA 瘦軟組織的子集。"}}}},
    "Fitdays 设备定义的肌肉量，不能与 DEXA 口径互换。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Muscle mass defined by the Fitdays device; not interchangeable with DEXA measures."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Fitdays 裝置定義的肌肉量，不能與 DEXA 口徑互換。"}}}},
    "设备估算的骨骼肌量，不等同于完整去脂体重。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Device-estimated skeletal muscle mass; not the same as total fat-free mass."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"裝置估算的骨骼肌量，不等同於完整去脂體重。"}}}},
    "骨骼肌指数，独立单位为 kg/m²。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Skeletal muscle index, measured separately in kg/m²."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"骨骼肌指數，獨立單位為 kg/m²。"}}}},
    "历史 DEXA 体脂率，只作历史对照。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Historical DEXA body-fat percentage, for comparison only."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"歷史 DEXA 體脂率，只作歷史對照。"}}}},
    "历史 DEXA 脂肪量。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Historical DEXA fat mass."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"歷史 DEXA 脂肪量。"}}}},
    "历史 DEXA lean soft tissue，不含骨矿物。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Historical DEXA lean soft tissue, excluding bone mineral."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"歷史 DEXA lean soft tissue，不含骨礦物。"}}}},
    "历史 DEXA 总重约值；不会由其他字段相加推算。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Approximate historical DEXA total mass; never inferred by adding other fields."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"歷史 DEXA 總重約值；不會由其他欄位相加推算。"}}}},
    "先建立你的个人资料" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Set Up Your Profile"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"先建立你的個人資料"}}}},
    "这些资料只保存在你的设备，用于计算热量和营养目标。Apple 健康中的最新数据仍会优先使用。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This information stays on your device and is used to calculate calorie and nutrition goals. The latest data from Apple Health still takes priority."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"這些資料只儲存在你的裝置上，用來計算熱量與營養目標。Apple 健康中的最新資料仍會優先使用。"}}}},
    "身体资料" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Body Details"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"身體資料"}}}},
    "身高" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Height"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"身高"}}}},
    "厘米" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"cm"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"公分"}}}},
    "生理性别" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Sex"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"生理性別"}}}},
    "请选择" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Select"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請選擇"}}}},
    "男" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Male"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"男"}}}},
    "女" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Female"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"女"}}}},
    "出生年份" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Birth Year"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"出生年份"}}}},
    "减重目标" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Weight-Loss Goal"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"減重目標"}}}},
    "千克" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"kg"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"公斤"}}}},
    "目标体重" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Goal Weight"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"目標體重"}}}},
    "目标日期" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Goal Date"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"目標日期"}}}},
    "请完整填写有效资料；目标体重需要低于当前体重。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Complete all fields with valid information. Goal weight must be below current weight."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請完整填寫有效資料；目標體重需低於目前體重。"}}}},
    "欢迎使用减重助手" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Welcome to WeightCoach"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"歡迎使用減重助手"}}}},
    "开始使用" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Get Started"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"開始使用"}}}},
    "咖啡因说明" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"About Caffeine"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"咖啡因說明"}}}},
    "mg · 今日已知" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"mg · known today"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"mg · 今日已知"}}}},
    "仅统计已记录数值；留空不会被误算成 0。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Only known values are counted. Blank entries are not treated as zero."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"只統計已記錄數值；留白不會被誤算為 0。"}}}},
    "400 mg 是 FDA 对多数健康成人的每日参考上限，不是你的个人目标。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"400 mg is the FDA’s daily reference limit for most healthy adults, not your personal goal."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"400 mg 是 FDA 對多數健康成人的每日參考上限，不是你的個人目標。"}}}},
    "怎么统计" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"How It’s Counted"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"如何統計"}}}},
    "只累加每条饮食记录里明确填写或由可靠品牌配方给出的咖啡因。普通照片看不出浓缩份数时，系统会保留为未知。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Only caffeine explicitly entered or provided by a reliable branded recipe is added. When a photo can’t reveal the number of espresso shots, caffeine remains unknown."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"只累加每筆飲食記錄中明確填寫或由可靠品牌配方提供的咖啡因。一般照片看不出濃縮份數時，系統會保留為未知。"}}}},
    "400 mg 参考" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"400 mg Reference"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"400 mg 參考"}}}},
    "FDA 表示，对多数健康成人而言，每天 400 mg 通常不会带来负面影响；敏感程度会因人、药物和健康状况而异。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The FDA says 400 mg per day is generally not associated with negative effects for most healthy adults. Sensitivity varies by person, medication, and health condition."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"FDA 表示，對多數健康成人而言，每天 400 mg 通常不會帶來負面影響；敏感程度會因人、藥物與健康狀況而異。"}}}},
    "孕期、哺乳期、心律问题或医生有特别要求时，请遵循专业建议。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"If you are pregnant, breastfeeding, have a heart-rhythm condition, or received specific medical advice, follow professional guidance."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"孕期、哺乳期、心律問題或醫師有特別要求時，請遵循專業建議。"}}}},
    "已超出" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Over By"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已超出"}}}},
    "还能吃" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Remaining"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"還能吃"}}}},
    "营养摄入" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Nutrition Intake"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"營養攝取"}}}},
    "营养目标如何计算" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"How Nutrition Goals Are Calculated"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"營養目標如何計算"}}}},
    "已摄入" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Consumed"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已攝取"}}}},
    "训练日 · 碳水稍高，总热量不变" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Training Day · More carbs, same calories"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"訓練日 · 碳水稍高，總熱量不變"}}}},
    "记录饮食后，这里会显示营养完成情况" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Log food to see your nutrition progress here"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"記錄飲食後，這裡會顯示營養完成情況"}}}},
    "部分记录缺少营养数据，宏量总计可能偏低" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Some entries lack nutrient data, so macro totals may be understated"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"部分記錄缺少營養資料，宏量總計可能偏低"}}}},
    "推荐方式" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recommendation Method"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"建議方式"}}}},
    "宏量目标只是在现有热量预算内做分配，不会改变你的每日预算。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Macro goals only allocate your existing calorie budget; they do not change the daily budget."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"宏量目標只是在現有熱量預算內分配，不會改變每日預算。"}}}},
    "训练日燃料调整" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Training-Day Fuel Adjustment"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"訓練日燃料調整"}}}},
    "默认关闭。开启后，训练日只会在相同总热量内适当提高碳水、降低脂肪；蛋白质不变，也不代表减脂会更快。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Off by default. When enabled, training days shift some calories from fat to carbs while keeping protein and total calories unchanged. It does not mean faster fat loss."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"預設關閉。開啟後，訓練日只會在相同總熱量內適度提高碳水、降低脂肪；蛋白質不變，也不代表減脂會更快。"}}}},
    "当前提示" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Current Note"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"目前提示"}}}},
    "当前热量预算不足以同时满足常规蛋白质和脂肪比例，目标已在预算内收紧。若长期出现，请核对减重目标并咨询注册营养师。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The current calorie budget is too low to meet the usual protein and fat targets together, so goals were tightened within the budget. If this persists, review your weight-loss goal and consult a registered dietitian."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"目前熱量預算不足以同時滿足一般蛋白質與脂肪比例，目標已在預算內收緊。若長期出現，請檢查減重目標並諮詢註冊營養師。"}}}},
    "慢性肾病、医生限制蛋白质、妊娠哺乳或需要药物配合饮食时，请使用医生或注册营养师给出的目标。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"If you have chronic kidney disease, a prescribed protein restriction, are pregnant or breastfeeding, or coordinate diet with medication, use goals from your doctor or registered dietitian."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"若有慢性腎病、醫師限制蛋白質、妊娠哺乳，或需配合藥物飲食，請使用醫師或註冊營養師提供的目標。"}}}},
    "热量消耗" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Energy Expenditure"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"熱量消耗"}}}},
    "热量消耗如何计算" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"How Energy Expenditure Is Calculated"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"熱量消耗如何計算"}}}},
    "今日总消耗估算" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Estimated Total Expenditure Today"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"今日總消耗估算"}}}},
    "手表活动模式" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Watch Activity Mode"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"手錶活動模式"}}}},
    "活动系数模式" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Activity-Factor Mode"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"活動係數模式"}}}},
    "基础代谢" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Basal Metabolism"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"基礎代謝"}}}},
    "Apple 健康活动" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Apple Health Activity"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Apple 健康活動"}}}},
    "健康活动（未计入）" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Health Activity (Excluded)"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"健康活動（未計入）"}}}},
    "手动运动补差" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Manual Exercise Supplement"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"手動運動補差"}}}},
    "手动运动（未计入）" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Manual Exercise (Excluded)"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"手動運動（未計入）"}}}},
    "目标缺口" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Target Deficit"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"目標缺口"}}}},
    "总消耗 = 基础代谢 × 1.1 + Apple 健康活动 + 未被健康记录的手动运动补差" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Total expenditure = BMR × 1.1 + Apple Health activity + manual exercise not captured by Health"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"總消耗 = 基礎代謝 × 1.1 + Apple 健康活動 + 未被健康記錄的手動運動補差"}}}},
    "总消耗 = 基础代谢 × 活动系数；Apple 健康与手动运动不重复叠加" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Total expenditure = BMR × activity factor; Apple Health and manual exercise are not added again"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"總消耗 = 基礎代謝 × 活動係數；Apple 健康與手動運動不重複疊加"}}}},
    "总消耗估算" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Total Expenditure Estimate"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"總消耗估算"}}}},
    "基础代谢 × 1.1" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"BMR × 1.1"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"基礎代謝 × 1.1"}}}},
    "手动运动估算" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Manual Exercise Estimate"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"手動運動估算"}}}},
    "其中健康已记录" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Already in Health"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"其中健康已記錄"}}}},
    "活动系数" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Activity Factor"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"活動係數"}}}},
    "当前使用活动系数模式，手动补记只展示，不额外计入预算。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Activity-factor mode is active. Manual entries are shown but not added to the budget."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"目前使用活動係數模式，手動補記只顯示，不會額外計入預算。"}}}},
    "合计" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Total"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"合計"}}}},
    "这里继续使用既有的消耗模型；按运动时间扣除 Apple 健康已经记录的活动能量，只补缺失部分。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This keeps the existing expenditure model. Apple Health activity for the exercise period is deducted so only the missing portion is added."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"這裡繼續使用既有的消耗模型；依運動時間扣除 Apple 健康已記錄的活動能量，只補缺失部分。"}}}},
    "今日饮食目标" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Today’s Food Goal"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"今日飲食目標"}}}},
    "动态目标缺口" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Dynamic Target Deficit"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"動態目標缺口"}}}},
    "今日热量目标" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Today’s Calorie Goal"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"今日熱量目標"}}}},
    "“还能吃”只用今日热量目标减去饮食摄入，不会再减一次运动消耗。" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"“Remaining” is today’s calorie goal minus food intake. Exercise isn’t subtracted a second time."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"「還能吃」只用今日熱量目標減去飲食攝取，不會再減一次運動消耗。"}}}},
    "热量消耗说明" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"About Energy Expenditure"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"熱量消耗說明"}}}},
